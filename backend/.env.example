PORT=5000
NODE_ENV=development

# Supabase (new key format)
SUPABASE_URL=your_supabase_url
SUPABASE_SECRET_KEY=your_supabase_secret_key

# JWT (app-level, not related to Supabase JWKS)
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend URL for CORS in production (optional, defaults to same-origin)
FRONTEND_URL=

# Admin (initial setup, used by seed script only)
ADMIN_EMAIL=admin@wwenatou.com
ADMIN_PASSWORD=change_this_password
