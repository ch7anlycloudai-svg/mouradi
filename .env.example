NODE_ENV=production
PORT=

# PostgreSQL Database
# Use DATABASE_URL or individual PG* variables
DATABASE_URL=
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Connection pool size (default: 5, shared hosting friendly)
PG_POOL_MAX=5

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS (optional, defaults to same-origin in production)
CORS_ORIGIN=
